{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "RootPath": "backend/storage"
  },
  "StatePersistence": {
    "Provider": "InMemory",
    "ConnectionString": "",
    "Schema": "public",
    "SnapshotKey": "main"
  },
  "FiscalEngines": {
    "Unimake": {
      "SchemaVersion": "4.00",
      "DefaultStateCode": "SP",
      "UseCertificateForStatusService": false,
      "AllowRealEmission": false,
      "ProcessVersion": "PackControl 2026.03",
      "ReceiptPollMaxAttempts": 5,
      "ReceiptPollDelayMs": 1500,
      "CertificatePath": "",
      "CertificateBase64": "",
      "CertificatePassword": "",
      "CertificateThumbprint": "",
      "HostHomologacao": "",
      "HostProducao": "",
      "RequestUriHomologacao": "",
      "RequestUriProducao": "",
      "WebEnderecoHomologacao": "",
      "WebEnderecoProducao": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  }
}
