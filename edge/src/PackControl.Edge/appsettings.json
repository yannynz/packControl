{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Edge": {
    "MachineName": "packcontrol-edge-dev",
    "SpoolDirectory": "edge/spool",
    "DebounceSeconds": 2,
    "WatchedDirectories": [
      {
        "Name": "pdf-inbox",
        "Path": "./edge/watch/pdf",
        "IncludeSubdirectories": true
      },
      {
        "Name": "dxf-inbox",
        "Path": "./edge/watch/dxf",
        "IncludeSubdirectories": true
      }
    ]
  }
}
